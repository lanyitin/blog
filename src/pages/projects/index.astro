---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const projects = [
	{
		href: '/projects/diagram-loom',
		name: 'Diagram Loom',
		taglineEn:
			'A Tauri desktop app that manages deployment and connectivity data, lints it for missing links, and produces C4 Model diagrams.',
		taglineZh:
			'以 Tauri 打造的桌面應用程式，管理系統的部署與連線資訊，檢查有沒有漏掉的連線，並產出 C4 Model 圖。',
		tags: ['Rust', 'Tauri', 'Vue 3', 'maxGraph', 'C4 Model', 'Lint'],
	},
	{
		href: '/projects/streamexa',
		name: 'Streamexa',
		taglineEn:
			'A Go system that detects, analyzes, and downloads video streams from web pages — built around a single binary with three modes and a gRPC plugin system.',
		taglineZh:
			'以 Go 打造、能偵測與下載網頁影音串流的系統，核心是單一 binary 三種模式與 gRPC 外掛架構。',
		tags: ['Go', 'gRPC', 'go-rod / CDP', 'Vue 3', 'Plugins'],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Projects" description="Things I have designed and built." />
	</head>
	<body>
		<Header />
		<main>
			<h1>Projects</h1>
			<p class="intro">
				A selection of things I have designed and built.
				<span lang="zh-Hant">我設計與開發過的一些專案。</span>
			</p>

			<ul class="project-list">
				{
					projects.map((project) => (
						<li>
							<a href={project.href} class="project-card">
								<h2>{project.name}</h2>
								<p class="tagline">{project.taglineEn}</p>
								<p class="tagline" lang="zh-Hant">
									{project.taglineZh}
								</p>
								<div class="tags">
									{project.tags.map((tag) => (
										<span class="tag">{tag}</span>
									))}
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		color: var(--color-fg-muted);
	}
	.intro span {
		display: block;
	}
	.project-list {
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.project-card {
		display: block;
		padding: 1.5rem;
		border: var(--rule-width) solid var(--color-rule);
		border-radius: var(--radius);
		background: var(--color-bg-subtle);
		color: inherit;
		text-decoration: none;
		transition:
			border-color var(--duration-fast) var(--ease-out),
			background var(--duration-fast) var(--ease-out);
	}
	.project-card:hover {
		border-color: var(--color-rule-strong);
		background: var(--color-bg-raised);
	}
	.project-card h2 {
		margin: 0 0 0.5rem;
		color: var(--color-accent);
		font-size: 1.4rem;
	}
	.tagline {
		margin: 0 0 0.4rem;
		color: var(--color-fg);
		font-size: 0.95rem;
		line-height: 1.65;
	}
	.tagline[lang='zh-Hant'] {
		color: var(--color-fg-muted);
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1rem;
	}
	.tag {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.06em;
		padding: 0.25rem 0.6rem;
		border: var(--rule-width) solid var(--color-rule);
		border-radius: var(--radius);
		background: var(--color-bg);
		color: var(--color-fg-muted);
	}
</style>
