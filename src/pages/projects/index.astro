---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const projects = [
	{
		href: '/projects/streamexa',
		name: 'Streamexa',
		taglineEn:
			'A Go system that detects, analyzes, and downloads video streams from web pages — built around a single binary with three modes and a gRPC plugin system.',
		taglineZh:
			'以 Go 打造、能偵測與下載網頁影音串流的系統,核心是單一 binary 三種模式與 gRPC 外掛架構。',
		tags: ['Go', 'gRPC', 'go-rod / CDP', 'Vue 3', 'Plugins'],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Projects" description="Things I have designed and built." />
	</head>
	<body>
		<Header />
		<main>
			<h1>Projects</h1>
			<p class="intro">
				A selection of things I have designed and built.
				<span lang="zh-Hant">我設計與開發過的一些專案。</span>
			</p>

			<ul class="project-list">
				{
					projects.map((project) => (
						<li>
							<a href={project.href} class="project-card">
								<h2>{project.name}</h2>
								<p class="tagline">{project.taglineEn}</p>
								<p class="tagline" lang="zh-Hant">
									{project.taglineZh}
								</p>
								<div class="tags">
									{project.tags.map((tag) => (
										<span class="tag">{tag}</span>
									))}
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		color: rgb(var(--gray));
	}
	.intro span {
		display: block;
	}
	.project-list {
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.project-card {
		display: block;
		padding: 1.5rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		color: inherit;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			transform 0.2s ease;
	}
	.project-card:hover {
		border-color: var(--accent);
		box-shadow: var(--box-shadow);
		transform: translateY(-2px);
	}
	.project-card h2 {
		margin: 0 0 0.5rem;
		color: var(--accent);
		font-size: 1.6rem;
	}
	.tagline {
		margin: 0 0 0.4rem;
		color: rgb(var(--gray-dark));
		font-size: 1rem;
		line-height: 1.6;
	}
	.tagline[lang='zh-Hant'] {
		color: rgb(var(--gray));
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1rem;
	}
	.tag {
		font-size: 0.8rem;
		padding: 0.2rem 0.6rem;
		border-radius: 999px;
		background: rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
	}
</style>
