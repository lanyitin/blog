---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: var(--width-page);
			}
			/* Cards flow into as many columns as the shell can fit at a legible card
			   width, so a 1440px screen gets three across and a laptop gets two. */
			ul {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
				gap: 2.5rem 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				grid-column: 1 / -1;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				max-height: 60vh;
				object-fit: cover;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			/* One ratio for every card image, so titles line up across a row
			   regardless of what shape the source file happens to be. */
			ul li img {
				width: 100%;
				aspect-ratio: 2 / 1;
				object-fit: cover;
				margin-bottom: 0.5rem;
				border-radius: var(--radius);
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: var(--color-fg);
				line-height: 1.25;
			}
			.date {
				margin: 0;
				font-family: var(--font-mono);
				font-size: 0.7em;
				letter-spacing: var(--tracking-label);
				text-transform: uppercase;
				color: var(--color-fg-faint);
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: var(--color-accent);
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					grid-template-columns: 1fr;
					gap: 2rem;
				}
				ul li {
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<img width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
